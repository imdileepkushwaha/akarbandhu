    <rect x="9.75" y="19.5" width="2.25" height="2.25" rx="0.35" fill="white" opacity="0.92"/>
    <rect x="7.5" y="23" width="3" height="4" rx="0.35" fill="white" opacity="0.75"/>
    <rect x="18" y="8" width="10" height="19" rx="1.25" fill="currentColor"/>
    <rect x="20.25" y="10.5" width="2.25" height="2.25" rx="0.35" fill="white" opacity="0.92"/>
    <rect x="23.5" y="10.5" width="2.25" height="2.25" rx="0.35" fill="white" opacity="0.92"/>
    <rect x="20.25" y="14.5" width="2.25" height="2.25" rx="0.35" fill="white" opacity="0.92"/>
    <rect x="23.5" y="14.5" width="2.25" height="2.25" rx="0.35" fill="white" opacity="0.92"/>
    <rect x="20.25" y="18.5" width="2.25" height="2.25" rx="0.35" fill="white" opacity="0.92"/>
    <rect x="23.5" y="18.5" width="2.25" height="2.25" rx="0.35" fill="white" opacity="0.92"/>
    <path d="M5 13V9l4.5-4 4.5 4v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M23 8V5l2.5-2.5L28 5v3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M25.5 5.5h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    <path d="M27.5 5.5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
</svg>
                        </span>
                        <span class="footer-logo-name"><%= Server.HtmlEncode(Settings.BrandName) %></span>
                    </a>
                    <div class="footer-socials">
                        <a href="<%= Server.HtmlEncode(Settings.FacebookUrl) %>" class="footer-social" aria-label="Facebook" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
                        </a>
                        <a href="<%= Server.HtmlEncode(Settings.InstagramUrl) %>" class="footer-social" aria-label="Instagram" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/></svg>
                        </a>
                        <a href="<%= Server.HtmlEncode(Settings.TwitterUrl) %>" class="footer-social" aria-label="Twitter" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        <a href="<%= Server.HtmlEncode(Settings.YoutubeUrl) %>" class="footer-social" aria-label="YouTube" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 00-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 00-1.94 2A29 29 0 001 11.75a29 29 0 00.46 5.33A2.78 2.78 0 003.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 001.94-2 29 29 0 00.46-5.25 29 29 0 00-.46-5.43zM9.75 15.02V8.48l5.75 3.27-5.75 3.27z"/></svg>
                        </a>
                    </div>
                </div>
                <p class="footer-mission">
                    <%= Server.HtmlEncode(Settings.FooterMission) %>
                </p>
            </div>

            <!-- Main columns -->
            <div class="footer-main">
                <div class="footer-col footer-newsletter">
                    <h3 class="footer-headline">
                        Building <span class="footer-accent">Better Infrastructure</span> for Tomorrow
                    </h3>
                    <p class="footer-desc">
                        Stay updated on our latest projects, government contracts, and infrastructure
                        developments across Patna and Bihar.
                    </p>
                    <div class="footer-subscribe">
                        <input type="email" name="email" placeholder="Enter Your email" required>
                        <button type="submit" aria-label="Subscribe">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                        </button></div>
                </div>

                <div class="footer-col footer-links-col">
                    <h4 class="footer-col-title">QUICK LINKS</h4>
                    <ul class="footer-list">
                        <li><a href="<%= ResolveUrl("~/index.aspx") %>#home">Home</a></li>
                        <li><a href="<%= ResolveUrl("~/index.aspx") %>#about">About Us</a></li>
                        <li><a href="<%= ResolveUrl("~/index.aspx") %>#services">Services</a></li>
                        <li><a href="<%= ResolveUrl("~/index.aspx") %>#projects">Projects</a></li>
                        <li><a href="<%= ResolveUrl("~/plans.aspx") %>">Plans</a></li>
                        <li><a href="<%= ResolveUrl("~/documents.aspx") %>">Documents</a></li>
                        <li><a href="<%= ResolveUrl("~/index.aspx") %>#contact">Contact Us</a></li>
                    </ul>
                </div>

                <div class="footer-col footer-services-col">
                    <h4 class="footer-col-title">OUR SERVICES</h4>
                    <ul class="footer-list">
                                                <li><a href="<%= ResolveUrl("~/index.aspx") %>#services">Newspaper Publication</a></li>
                                                <li><a href="<%= ResolveUrl("~/index.aspx") %>#services">Govt. Construction</a></li>
                                                <li><a href="<%= ResolveUrl("~/index.aspx") %>#services">Material Supply</a></li>
                                                <li><a href="<%= ResolveUrl("~/index.aspx") %>#services">Railway Contracts</a></li>
                                                <li><a href="<%= ResolveUrl("~/index.aspx") %>#services">Social Impact</a></li>
                                                <li><a href="<%= ResolveUrl("~/index.aspx") %>#services">Community Leadership</a></li>
                                                <li><a href="<%= ResolveUrl("~/index.aspx") %>#services">Real Estate</a></li>
                                            </ul>
                </div>

                <div class="footer-col footer-contact-col">
                    <h4 class="footer-col-title">CONTACT INFORMATIONS</h4>
                    <div class="footer-contact-list">
                        <div class="footer-contact-item">
                            <span class="footer-contact-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                            </span>
                            <div>
                                <small>Call us on</small>
                                <a href="<%= Settings.MobileHref %>"><%= Server.HtmlEncode(Settings.Mobile) %></a>
                            </div>
                        </div>
                        <div class="footer-contact-item">
                            <span class="footer-contact-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            </span>
                            <div>
                                <small>Reach out</small>
                                <a href="<%= Settings.EmailHref %>"><%= Server.HtmlEncode(Settings.Email) %></a>
                            </div>
                        </div>
                        <% if (!string.IsNullOrWhiteSpace(Settings.WhatsApp)) { %>
                        <div class="footer-contact-item">
                            <span class="footer-contact-icon">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.85 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                            </span>
                            <div>
                                <small>WhatsApp</small>
                                <a href="<%= Settings.WhatsAppHref %>" target="_blank" rel="noopener"><%= Server.HtmlEncode(Settings.WhatsApp) %></a>
                            </div>
                        </div>
                        <% } %>
                        <div class="footer-contact-item">
                            <span class="footer-contact-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            </span>
                            <div>
                                <small>Location</small>
                                <span><%= Server.HtmlEncode(Settings.Address) %></span>
                            </div>
                        </div>
                        <div class="footer-contact-item">
                            <span class="footer-contact-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </span>
                            <div>
                                <small>Office Hours</small>
                                <span><%= Server.HtmlEncode(Settings.OfficeHours) %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; <%= DateTime.Now.Year %> <%= Server.HtmlEncode(Settings.CompanyName) %> — All Rights Reserved</p>
                <p class="footer-legal-line">CIN: <%= Server.HtmlEncode(Settings.Cin) %> · PAN: <%= Server.HtmlEncode(Settings.Pan) %> · TAN: <%= Server.HtmlEncode(Settings.Tan) %></p>
            </div>
        </div>
    </footer>

    <% if (!string.IsNullOrWhiteSpace(Settings.WhatsApp)) { %>
    <a href="<%= Settings.WhatsAppHref %>" class="wa-float" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.85 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
    <% } %>

    <script src="<%= ResolveUrl("~/assets/js/main.js") %>"></script>
    </form>
</body>
</html>