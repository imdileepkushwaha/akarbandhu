        <script>
            Sys.Application.add_load(LoadHandler);
            function LoadHandler() {
                $('.form_date').datepicker({
                    format: 'dd/mm/yyyy',
                }).on('changeDate', function (ev) {
                    $(this).datepicker('hide');
                });
            }
        </script>
        <script type="text/javascript">

            $('.form_date').datepicker({
                format: 'dd/mm/yyyy',
            }).on('changeDate', function (ev) {
                $(this).datepicker('hide');
            });
            function isNumber(evt) {
                evt = (evt) ? evt : window.event;
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 45 || charCode > 57)) {
                    return false;
                }
                return true;
            }

        </script>
        <script>


            $(function () {
                var url = window.location.pathname;
                var pagename = url.substring(url.lastIndexOf('/') + 1, url.length);
                $('#nav2 li').each(function (i) {

                    var thisurl = $(this).find('a').attr('href');
                    if (thisurl.substring(thisurl.lastIndexOf('/') + 1, thisurl.length) == pagename) {
                        $(this).find('a').addClass('active2');
                        //   $(this).find('span').addClass('selected');
                        $(this).addClass('active2');
                        $(this).closest('ul').closest('li').addClass('active2 open');
                        //     var thisurl = $(this).append('  <span class="selected"></span>');
                        // var thisurl = $(this).append(' <span class="selected">fff</span>');
                    }
                    $('#nav2 li ul li').each(function (i) {

                        //alert($(this).find('a').attr('href'));
                        var thisurl2 = '';
                        thisurl2 = $(this).find('a').attr('href');
                        if (thisurl2.substring(thisurl2.lastIndexOf('/') + 1, thisurl2.length) == pagename) {
                            $(this).find('a').addClass('active2');
                            $(this).addClass('active2');
                            $(this).parent().css('display', 'block');
                            $(this).parent().parent().addClass('open menu-open');
                        }
                    });
                });
            });
        </script>
        <asp:ContentPlaceHolder ID="contentScript" runat="server"></asp:ContentPlaceHolder>
