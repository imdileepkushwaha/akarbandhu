    <script>
        (function () {
            function hideAbPageLoader() {
                var el = document.querySelector('.loader-bg');
                if (!el || el.classList.contains('is-done')) return;
                el.classList.add('is-done');
                if (window.jQuery) {
                    window.jQuery(el).stop(true, true).fadeOut(280, function () {
                        window.jQuery(this).remove();
                    });
                } else if (el.parentNode) {
                    el.parentNode.removeChild(el);
                }
            }
            if (document.readyState === 'complete') {
                setTimeout(hideAbPageLoader, 350);
            } else {
                window.addEventListener('load', function () {
                    setTimeout(hideAbPageLoader, 350);
                });
            }
            setTimeout(hideAbPageLoader, 4000);
        })();
    </script>
    <script>
        (function () {
            function syncAbNavOpen() {
                var open = !!document.querySelector('.pcoded-navbar.mob-open');
                document.body.classList.toggle('ab-nav-open', open);
            }
            function closeAbNav() {
                var nav = document.querySelector('.pcoded-navbar.mob-open');
                if (!nav) return;
                nav.classList.remove('mob-open');
                document.querySelectorAll('#mobile-collapse, #mobile-collapse1, .mobile-menu').forEach(function (el) {
                    el.classList.remove('on');
                });
                syncAbNavOpen();
            }
            document.addEventListener('click', function (e) {
                if (!document.body.classList.contains('ab-nav-open')) return;
                var t = e.target;
                if (t === document.body) {
                    closeAbNav();
                    return;
                }
                if (t.closest && t.closest('.pcoded-main-container') && !t.closest('.pcoded-navbar')) {
                    closeAbNav();
                }
            });
            if (window.MutationObserver) {
                var nav = document.querySelector('.pcoded-navbar');
                if (nav) {
                    new MutationObserver(syncAbNavOpen).observe(nav, { attributes: true, attributeFilter: ['class'] });
                }
            }
            window.addEventListener('resize', function () {
                if (window.innerWidth > 991) closeAbNav();
                else syncAbNavOpen();
            });
            document.addEventListener('DOMContentLoaded', syncAbNavOpen);
        })();
    </script>
        <link href="assets/js/toastr.css" rel="stylesheet" />
        <script src="assets/js/toastr.js"></script>
        <script src="assets/js/bootstrap-datepicker.js"></script>
        <script>
            function initAbDatepickers() {
                $('.form_date').each(function () {
                    var $el = $(this);
                    if ($el.data('datepicker')) {
                        return;
                    }
                    $el.datepicker({
                        format: 'dd/mm/yyyy',
                        autoclose: true
                    }).on('changeDate', function () {
                        $(this).datepicker('hide');
                    });
                });
            }
            Sys.Application.add_load(function () {
                initAbDatepickers();
            });
            $(function () {
                initAbDatepickers();
            });
        </script>
        <script type="text/javascript">
            function isNumber(evt) {
                evt = (evt) ? evt : window.event;
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 45 || charCode > 57)) {
                    return false;
                }
                return true;
            }
        </script>
         <asp:ContentPlaceHolder ID="contentScript" runat="server"></asp:ContentPlaceHolder>
    <script type="text/javascript">
        (function () {
            function bindFileUploads(root) {
                var scope = root || document;
                scope.querySelectorAll('.ab-file').forEach(function (wrap) {
                    var input = wrap.querySelector('input[type="file"]');
                    var nameEl = wrap.querySelector('.ab-file-name');
                    if (!input || input._abFileBound) return;
                    input._abFileBound = true;

                    input.addEventListener('change', function () {
                        if (!nameEl) return;
                        if (input.files && input.files.length) {
                            nameEl.textContent = input.files[0].name;
                            nameEl.classList.add('has-file');
                        } else {
                            nameEl.textContent = 'No file selected';
                            nameEl.classList.remove('has-file');
                        }
                    });

                    ['dragenter', 'dragover'].forEach(function (evt) {
                        wrap.addEventListener(evt, function (e) {
                            e.preventDefault();
                            wrap.classList.add('is-dragover');
                        });
                    });
                    ['dragleave', 'drop'].forEach(function (evt) {
                        wrap.addEventListener(evt, function (e) {
                            e.preventDefault();
                            wrap.classList.remove('is-dragover');
                        });
                    });
                });
            }

            document.addEventListener('DOMContentLoaded', function () { bindFileUploads(document); });
            if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                    bindFileUploads(document);
                });
            }
        })();
    </script>
    </form>
</body>
</html>
